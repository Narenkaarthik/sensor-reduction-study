    family-names: Kaarthik

repository-code: https://github.com/Narenkaarthik/sensor-reduction-study

# The CONCEPT doi: it always resolves to the newest archived version, which
# is what someone citing this software generally wants. The v1.0.0 snapshot
# that produced the published numbers is 10.5281/zenodo.24087302, and that
# is the one the paper cites.
identifiers:
