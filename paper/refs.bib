% ===========================================================================
% BIN 2 -> II-A: The MaFaulDa dataset and published results on it
% ===========================================================================
%
% VERIFIED 2026-10-31 by reading the PDF itself
% (https://www.smt.ufrj.br/~sergioln/papers/IJ28.pdf, which redirects to
% www02.smt.ufrj.br). Author list, journal, volume, year, page range and DOI
% are all taken from the article's own first page, not from an aggregator.
%
% WHAT IT ACTUALLY DID, read from Section 5 of the paper, because the paper's
% evaluation protocol is the reason we cite it:
%   - "The whole MaFaulDa database was randomly separated in two disjoint
%     training and test sets, comprising respectively 90% and 10% of the
%     given scenarios. The random choice of each set was constrained so that
%     both presented the same fault proportion as the whole database."
%   - Parameters were then chosen by 10-fold cross-validation on the training
%     samples.
%   - A "scenario" is one whole 5 s recording. MaFaulDa recordings are NOT
%     segmented into windows in that paper; only the CWRU signals are ("each
%     CWRU signal was divided into 15 segments").
%   - Reported accuracy: 98.5% on MaFaulDa, 98.9% on CWRU.
%
% CONSEQUENCE FOR OUR COMPARISON, and the reason II-A is worded as it is:
% their split is at RECORDING level, so it is NOT window-level leakage. It
% corresponds to our SECONDARY (held-out recordings) protocol, not to our
% primary held-out speed bands, because speeds are shared between their train
% and test sets. Do not describe this paper as leaky; say which of our two
% protocols it lines up with.
%
@article{marins2018,
  author  = {Marins, Matheus A. and Ribeiro, Felipe M. L. and
             Netto, Sergio L. and da Silva, Eduardo A. B.},
  title   = {Improved similarity-based modeling for the classification of
             rotating-machine failures},
  journal = {Journal of the Franklin Institute},
  volume  = {355},
  number  = {4},
  pages   = {1913--1930},
  year    = {2018},
  doi     = {10.1016/j.jfranklin.2017.07.038}
}

