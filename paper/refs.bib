% VERIFIED 2026-10-31 against the PubMed Central record PMC2491635
% (PMID 18620558), which gives BMC Bioinformatics 2008 Jul 11;9:307 and the
% DOI. The DOAJ record transposes given and family names; the PMC listing was
% used instead.
%
% Supports (II-C) and the Discussion of Fig. 2: that permutation importance
% is biased in the presence of correlated predictors, and that the marginal
% measure does not separate "carries no information" from "redundant". The
% paper's own words: these measures "show a bias towards correlated predictor
% variables", and it proposes a conditional scheme as the remedy.
%
% NOTE: we do NOT implement their conditional permutation scheme. We cite
% them for the limitation, and we respond to it with forward selection,
% single-sensor scores and the correlation matrices instead. Do not let the
% citation imply we adopted their method.
%
@article{strobl2008,
  author  = {Strobl, Carolin and Boulesteix, Anne-Laure and Kneib, Thomas and
             Augustin, Thomas and Zeileis, Achim},
  title   = {Conditional variable importance for random forests},
  journal = {BMC Bioinformatics},
  volume  = {9},
  pages   = {307},
  year    = {2008},
  doi     = {10.1186/1471-2105-9-307}
}

% ===========================================================================
% BIN 5 -> II-C: Data leakage in machinery datasets
% ===========================================================================
%
% VERIFIED 2026-10-31. The British Library catalogue record gives Mechanical
% Systems and Signal Processing volume 169, 15 April 2022, authors Jacob
% Hendriks, Patrick Dumond and D. A. Knox; citing papers give article 108732,
% which matches the DOI. NOTE the spelling "Dumond", not "Dumont".
%
% Supports (II-C): that splitting correlated segments at random inflates
% reported results in machinery datasets, and that building train and test
% sets from independent hardware is the remedy. The paper proposes a
% benchmarking framework that builds training and testing sets from
% independent sets of bearings, and later work cites it for exactly the data
% leakage point.
%
% CAUTION when citing: this paper is about CWRU, not MaFaulDa, and about
% independent BEARINGS rather than our grouping by recording or speed band.
% Cite it for the phenomenon and the principle, not as a protocol we copied.
%
@article{hendriks2022,
  author  = {Hendriks, Jacob and Dumond, Patrick and Knox, D. A.},
  title   = {Towards better benchmarking using the {CWRU} bearing fault
             dataset},
  journal = {Mechanical Systems and Signal Processing},
  volume  = {169},
  pages   = {108732},
  year    = {2022},
  doi     = {10.1016/j.ymssp.2021.108732}
}

