% ===========================================================================
% STATISTICAL METHODS (added 2026-11-09)
% ===========================================================================
%
% A review found that five named methods carried no citation. Eponymous
% methods without references is a routine desk complaint, and the
% Nadeau-Bengio correction in particular does load-bearing work on this
% paper's central claim.
%
% VERIFIED 2026-11-09 against the MLanthology record for Machine Learning
% 2003, which gives volume 52, pages 239-281 and the DOI; corroborated by a
% second bibliographic database with the same page range and DOI.
%
% CITE THE 2003 JOURNAL VERSION, not the 1999 NIPS paper of the same title.
%
% CAUTION ON WHAT THIS SUPPORTS: Nadeau and Bengio derive the correction for
% repeated random subsampling. Applying it to repeated k-fold, as we do, is
% the common adaptation and the variance factor becomes 1/n + 1/(k-1). The
% paper should cite them for the correction and not imply they derived the
% k-fold form.
%
@article{nadeau2003,
  author  = {Nadeau, Claude and Bengio, Yoshua},
  title   = {Inference for the Generalization Error},
  journal = {Machine Learning},
  volume  = {52},
  number  = {3},
  pages   = {239--281},
  year    = {2003},
  doi     = {10.1023/A:1024068626366}
}

